# Disable script execution & directory listing

Options -ExecCGI -Indexes

# Mechanism 1: Disable PHP engine for standard Apache mod_php installations

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Mechanism 2: Explicitly deny PHP extensions (necessary for PHP-FPM / LiteSpeed servers)

<FilesMatch "\.(php[0-9]?|phtml|phar)$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# Restrict uploads strictly to valid image types

<FilesMatch "^(?!\.(jpe?g|png)$)">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
</FilesMatch>
