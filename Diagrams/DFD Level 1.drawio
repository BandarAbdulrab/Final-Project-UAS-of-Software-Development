        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    CAS[Cashier]\n    ADM[Admin / Owner]\n\n    P1((\&quot;1.0&lt;br/&gt;Login, Rate Limiting&lt;br/&gt;and Users\&quot;))\n    P2((\&quot;2.0&lt;br/&gt;Manage Menu&lt;br/&gt;and Modifiers\&quot;))\n    P3((\&quot;3.0&lt;br/&gt;Process Orders&lt;br/&gt;and Payment\&quot;))\n    P4((\&quot;4.0&lt;br/&gt;Order Queue\&quot;))\n    P5((\&quot;5.0&lt;br/&gt;History, Reports,&lt;br/&gt;Export and Void\&quot;))\n    P6((\&quot;6.0&lt;br/&gt;Settings\&quot;))\n    P7((\&quot;7.0&lt;br/&gt;Manual Financial&lt;br/&gt;Records\&quot;))\n    P8((\&quot;8.0&lt;br/&gt;Cash Closing\&quot;))\n\n    D1[(\&quot;D1 menu\&quot;)]\n    D2[(\&quot;D2 transactions\&quot;)]\n    D3[(\&quot;D3 orders\&quot;)]\n    D4[(\&quot;D4 users\&quot;)]\n    D5[(\&quot;D5 settings\&quot;)]\n    D6[(\&quot;D6 finance\&quot;)]\n    D7[(\&quot;D7 menu_modifier_groups\&quot;)]\n    D8[(\&quot;D8 menu_modifier_items\&quot;)]\n    D9[(\&quot;D9 order_item_modifiers\&quot;)]\n    D10[(\&quot;D10 cash_closings\&quot;)]\n    D11[(\&quot;D11 login_attempts\&quot;)]\n\n    %% P1\n    CAS --&gt;|credentials| P1\n    ADM --&gt;|\&quot;credentials, user_data, own password change\&quot;| P1\n    P1 --&gt;|\&quot;menu per access rights, lock / error message\&quot;| CAS\n    P1 --&gt;|\&quot;menu per access rights, lock / error message\&quot;| ADM\n    P1 &lt;--&gt;|\&quot;user records\&quot;| D4\n    P1 &lt;--&gt;|\&quot;failed attempts: check, log, clear, purge 24h\&quot;| D11\n\n    %% P2\n    ADM --&gt;|\&quot;menu_data, modifier_group_data, modifier_item_data\&quot;| P2\n    CAS --&gt;|\&quot;availability toggle\&quot;| P2\n    P2 &lt;--&gt;|menu rows| D1\n    P2 &lt;--&gt;|groups| D7\n    P2 &lt;--&gt;|items| D8\n\n    %% P3\n    CAS --&gt;|\&quot;order_item, modifier_selection, service_data, payment_data, confirmation + checkout token\&quot;| P3\n    D1 --&gt;|\&quot;price, cost, availability\&quot;| P3\n    D7 --&gt;|\&quot;group rules\&quot;| P3\n    D8 --&gt;|\&quot;extra price / cost, availability\&quot;| P3\n    D5 --&gt;|\&quot;operating_percent, table_count, QRIS, receipt_text\&quot;| P3\n    P3 --&gt;|\&quot;transaction + profit + fund allocation\&quot;| D2\n    P3 --&gt;|\&quot;item lines\&quot;| D3\n    P3 --&gt;|\&quot;frozen modifier snapshot\&quot;| D9\n    P3 --&gt;|\&quot;total, change, QRIS image, order number, receipt\&quot;| CAS\n\n    %% P4\n    CAS --&gt;|\&quot;completion_marking\&quot;| P4\n    D2 --&gt;|\&quot;processing orders\&quot;| P4\n    D3 --&gt;|\&quot;items\&quot;| P4\n    D9 --&gt;|\&quot;modifier snapshot\&quot;| P4\n    P4 --&gt;|\&quot;completed status, completed_at, duration\&quot;| D2\n    P4 --&gt;|\&quot;queue (with modifiers)\&quot;| CAS\n\n    %% P5\n    CAS --&gt;|\&quot;history filter, sort, export request\&quot;| P5\n    ADM --&gt;|\&quot;report_parameters, filters, sort, export_request, void_request (id + reason)\&quot;| P5\n    D2 --&gt;|\&quot;transactions (void excluded from aggregates)\&quot;| P5\n    D3 --&gt;|\&quot;order lines\&quot;| P5\n    D9 --&gt;|\&quot;modifier snapshot\&quot;| P5\n    D1 --&gt;|\&quot;menu names\&quot;| P5\n    D6 --&gt;|\&quot;manual income / expenses\&quot;| P5\n    D4 --&gt;|\&quot;cashier / voider names\&quot;| P5\n    D5 --&gt;|\&quot;business name, receipt text, operating_percent\&quot;| P5\n    P5 --&gt;|\&quot;void record: status, void_reason, voided_at, voided_by\&quot;| D2\n    P5 --&gt;|\&quot;today&#39;s history, cashier dashboard, CSV / print view\&quot;| CAS\n    P5 --&gt;|\&quot;reports, history, dashboard, CSV / print view, void confirmation\&quot;| ADM\n\n    %% P6\n    ADM --&gt;|\&quot;settings\&quot;| P6\n    P6 &lt;--&gt;|\&quot;single settings row\&quot;| D5\n\n    %% P7\n    ADM --&gt;|\&quot;manual_finance_data, filters, sort, export request\&quot;| P7\n    P7 &lt;--&gt;|\&quot;finance rows\&quot;| D6\n    P7 --&gt;|\&quot;ledger, balances, CSV / print view\&quot;| ADM\n\n    %% P8\n    ADM --&gt;|\&quot;cash_closing_data (date, opening, cash out, counted, note)\&quot;| P8\n    D2 --&gt;|\&quot;non-void cash totals of the date\&quot;| P8\n    D4 --&gt;|\&quot;operator names\&quot;| P8\n    P8 &lt;--&gt;|\&quot;closings (one per date); stale check: stored vs current cash_sales\&quot;| D10\n    P8 --&gt;|\&quot;cash_sales, expected cash, variance, closing history\&quot;| ADM\n    P8 --&gt;|\&quot;closing history (read-only)\&quot;| CAS&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="pfgo8geh6NPG3Lf6N_Xm-1">
