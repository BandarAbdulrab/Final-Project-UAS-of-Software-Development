  <diagram name="‫الصفحة-1‬" id="X0DH3WrbuYq108tRi6Wo">
    <mxGraphModel dx="4061" dy="2800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class User {\n        -int user_id\n        -String username\n        -String password_hash\n        -String name\n        -String role\n        -boolean status\n        +login(username, password) boolean\n        +logout() void\n        +changeOwnPassword(current, new) void\n        +addUser() void\n        +editUser() void\n        +deactivateAccount() void\n        +resetPassword() void\n        +voidOrder(transactionId, reason) boolean\n        +closeCashDrawer(date) void\n    }\n    class LoginAttempt {\n        -int attempt_id\n        -String username\n        -String ip_address\n        -DateTime attempted_at\n        +logFailure() void\n        +isLocked(username, ip) boolean\n        +clearAttempts() void\n        +purgeOlderThan24h() void\n    }\n    class Settings {\n        -String business_name\n        -String business_address\n        -int table_count\n        -String receipt_footer\n        -decimal operating_percent\n        -String qris_bank\n        -String qris_owner_name\n        -String qris_image\n        +saveSettings() void\n        +getSettings() Settings\n    }\n    class Menu {\n        -int menu_id\n        -String name\n        -String category\n        -int price\n        -int cost_price\n        -String photo\n        -boolean available\n        -boolean status\n        +addMenu() void\n        +editMenu() void\n        +changeAvailability() void\n        +activateDeactivate() void\n    }\n    class ModifierGroup {\n        -int group_id\n        -int menu_id\n        -String name\n        -String type\n        -boolean is_required\n        +addGroup() void\n        +editGroup() void\n        +deleteGroup() void\n    }\n    class ModifierItem {\n        -int modifier_id\n        -int group_id\n        -String name\n        -int extra_price\n        -int extra_cost\n        -boolean available\n        +addItem() void\n        +editItem() void\n        +setAvailability() void\n        +deleteItem() void\n    }\n    class Transaction {\n        -int transaction_id\n        -int order_no\n        -DateTime date\n        -String table_no\n        -String method\n        -int total\n        -int paid\n        -int change_due\n        -String status\n        -DateTime completed_at\n        -int duration_seconds\n        -int total_cost\n        -int gross_profit\n        -int alloc_restock\n        -int alloc_operating\n        -int alloc_profit\n        -int user_id\n        -Date order_date\n        -String void_reason\n        -DateTime voided_at\n        -int voided_by\n        +calculateTotal() int\n        +calculateChange() int\n        +calculateProfitAllocation() void\n        +completeTransaction(checkoutToken) boolean\n        +printReceipt() void\n        +markCompleted() void\n        +void(reason, adminId) boolean\n        +viewHistory(filter, sort, page) List\n        +exportCsv() void\n        +printView() void\n    }\n    class OrderItem {\n        -int order_id\n        -int transaction_id\n        -int menu_id\n        -int quantity\n        -int price\n        -int cost_price\n        -int modifier_price\n        -int modifier_cost\n        -int subtotal\n        +addItem() void\n        +changeQuantity() void\n        +deleteItem() void\n        +calculateSubtotal() int\n    }\n    class OrderItemModifier {\n        -int order_modifier_id\n        -int order_id\n        -String modifier_name\n        -int price\n        -int cost_price\n        +freeze() void\n    }\n    class Finance {\n        -int finance_id\n        -DateTime date\n        -String type\n        -String category\n        -String pool\n        -int amount\n        -String description\n        -int user_id\n        +record() void\n        +edit() void\n        +delete() void\n        +calculateBalance(period) int\n        +exportCsv() void\n        +printView() void\n    }\n    class CashClosing {\n        -int closing_id\n        -Date closing_date\n        -int user_id\n        -int opening_cash\n        -int cash_sales\n        -int cash_out\n        -int expected_cash\n        -int counted_cash\n        -int difference\n        -String note\n        -DateTime created_at\n        +calculateCashSales() int\n        +calculateExpected() int\n        +calculateDifference() int\n        +saveClosing() void\n        +isStale() boolean\n        +viewHistory() List\n    }\n    class Report {\n        -int total_orders\n        -int revenue\n        -int gross_profit\n        -int net_profit\n        -int expenses\n        -int cash_balance\n        -int avg_duration\n        +generateReport(period, sort) Report\n        +calculatePoolBalances() void\n        +salesPerMenu() List\n        +voidedSummary() Map\n        +dailyBreakdown() List\n        +exportCsv() void\n        +printReport() void\n    }\n    class Dashboard {\n        +cashierSummary() Map\n        +adminSummary() Map\n    }\n\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Transaction : serves\n    User \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Transaction : voids\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Finance : records\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; CashClosing : closes\n    User ..&gt; LoginAttempt : uses\n    Transaction \&quot;1\&quot; *-- \&quot;1..*\&quot; OrderItem : has\n    Menu \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OrderItem : ordered in\n    Menu \&quot;1\&quot; *-- \&quot;0..5\&quot; ModifierGroup : has groups\n    ModifierGroup \&quot;1\&quot; *-- \&quot;0..10\&quot; ModifierItem : offers\n    OrderItem \&quot;1\&quot; *-- \&quot;0..*\&quot; OrderItemModifier : frozen snapshot\n    CashClosing ..&gt; Transaction : use\n    Report ..&gt; Transaction : use\n    Report ..&gt; Finance : use\n    Dashboard ..&gt; Transaction : use&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="OkpWjZYLhtcw204oI4wY-1">
