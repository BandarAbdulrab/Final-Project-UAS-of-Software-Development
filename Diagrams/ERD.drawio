  <diagram name="‫الصفحة-1‬" id="AsLSlfxsoK5t1q6JkW1E">
    <mxGraphModel dx="3336" dy="2300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    users ||--o{ transactions : \&quot;serves (user_id)\&quot;\n    users |o--o{ transactions : \&quot;voids (voided_by)\&quot;\n    users ||--o{ finance : records\n    users ||--o{ cash_closings : closes\n    transactions ||--|{ orders : contains\n    menu ||--o{ orders : \&quot;ordered in\&quot;\n    orders ||--o{ order_item_modifiers : \&quot;has snapshot\&quot;\n    menu ||--o{ menu_modifier_groups : \&quot;has groups (max 5)\&quot;\n    menu_modifier_groups ||--o{ menu_modifier_items : \&quot;offers (max 10)\&quot;\n\n    users {\n        INT user_id PK \&quot;AUTO_INCREMENT\&quot;\n        VARCHAR(50) username UK \&quot;NOT NULL\&quot;\n        VARCHAR(255) password_hash \&quot;bcrypt, NOT NULL\&quot;\n        VARCHAR(100) name \&quot;NOT NULL\&quot;\n        ENUM role \&quot;admin, cashier\&quot;\n        TINYINT(1) status \&quot;1 = active\&quot;\n    }\n    menu {\n        INT menu_id PK \&quot;AUTO_INCREMENT\&quot;\n        VARCHAR(100) name \&quot;NOT NULL\&quot;\n        VARCHAR(30) category \&quot;DEFAULT Lainnya; cashier filter pills\&quot;\n        INT price \&quot;Rupiah, &gt;= 0\&quot;\n        INT cost_price \&quot;Rupiah, &gt;= 0\&quot;\n        VARCHAR(100) photo \&quot;NULL, max 1 MB\&quot;\n        TINYINT(1) available \&quot;1 available, 0 sold out\&quot;\n        TINYINT(1) status \&quot;1 active\&quot;\n    }\n    menu_modifier_groups {\n        INT group_id PK \&quot;AUTO_INCREMENT\&quot;\n        INT menu_id FK \&quot;menu.menu_id RESTRICT\&quot;\n        VARCHAR(50) name \&quot;Size, Spice Level, Toppings\&quot;\n        ENUM type \&quot;single, multiple\&quot;\n        TINYINT(1) is_required \&quot;1 mandatory\&quot;\n    }\n    menu_modifier_items {\n        INT modifier_id PK \&quot;AUTO_INCREMENT\&quot;\n        INT group_id FK \&quot;ON DELETE CASCADE\&quot;\n        VARCHAR(50) name \&quot;Large, Level 3, Extra Egg\&quot;\n        INT extra_price \&quot;Rupiah &gt;= 0\&quot;\n        INT extra_cost \&quot;Rupiah &gt;= 0\&quot;\n        TINYINT(1) available \&quot;1 selectable\&quot;\n    }\n    transactions {\n        INT transaction_id PK \&quot;AUTO_INCREMENT\&quot;\n        INT order_no \&quot;sequential per day\&quot;\n        DATETIME date \&quot;order time\&quot;\n        VARCHAR(10) table_no \&quot;number or TA\&quot;\n        ENUM method \&quot;cash, qris\&quot;\n        INT total\n        INT paid \&quot;CHECK paid &gt;= total\&quot;\n        INT change_due\n        ENUM status \&quot;processing, completed, void\&quot;\n        DATETIME completed_at \&quot;NULL\&quot;\n        INT duration_seconds \&quot;NULL\&quot;\n        INT total_cost \&quot;includes modifier costs\&quot;\n        INT gross_profit \&quot;can be negative\&quot;\n        INT alloc_restock\n        INT alloc_operating\n        INT alloc_profit\n        INT user_id FK \&quot;users.user_id\&quot;\n        DATE order_date UK \&quot;GENERATED STORED DATE(date); UNIQUE(order_date, order_no)\&quot;\n        VARCHAR(255) void_reason \&quot;NULL; 3-255 chars when void (chk_trx_void)\&quot;\n        DATETIME voided_at \&quot;NULL\&quot;\n        INT voided_by FK \&quot;users.user_id, NULL\&quot;\n    }\n    orders {\n        INT order_id PK \&quot;AUTO_INCREMENT\&quot;\n        INT transaction_id FK \&quot;RESTRICT\&quot;\n        INT menu_id FK \&quot;RESTRICT\&quot;\n        INT quantity \&quot;&gt; 0\&quot;\n        INT price \&quot;base price at transaction time\&quot;\n        INT cost_price \&quot;base cost at transaction time\&quot;\n        INT modifier_price \&quot;sum extra prices per unit\&quot;\n        INT modifier_cost \&quot;sum extra costs per unit\&quot;\n        INT subtotal \&quot;(price + modifier_price) x quantity\&quot;\n    }\n    order_item_modifiers {\n        INT order_modifier_id PK \&quot;AUTO_INCREMENT\&quot;\n        INT order_id FK \&quot;orders.order_id; NO FK to modifier tables\&quot;\n        VARCHAR(50) modifier_name \&quot;frozen\&quot;\n        INT price \&quot;frozen extra price\&quot;\n        INT cost_price \&quot;frozen extra cost\&quot;\n    }\n    finance {\n        INT finance_id PK \&quot;AUTO_INCREMENT\&quot;\n        DATETIME date\n        ENUM type \&quot;income, expense\&quot;\n        VARCHAR(100) category\n        ENUM pool \&quot;restock, operating, profit\&quot;\n        INT amount \&quot;&gt; 0\&quot;\n        VARCHAR(200) description \&quot;NULL\&quot;\n        INT user_id FK \&quot;users.user_id\&quot;\n    }\n    cash_closings {\n        INT closing_id PK \&quot;AUTO_INCREMENT\&quot;\n        DATE closing_date UK \&quot;one closing per date\&quot;\n        INT user_id FK \&quot;admin who saved\&quot;\n        INT opening_cash \&quot;DEFAULT 0, &gt;= 0\&quot;\n        INT cash_sales \&quot;non-void cash totals\&quot;\n        INT cash_out \&quot;&gt;= 0, never written to finance\&quot;\n        INT expected_cash \&quot;opening + sales - cash out\&quot;\n        INT counted_cash \&quot;&gt;= 0\&quot;\n        INT difference \&quot;counted - expected\&quot;\n        VARCHAR(255) note \&quot;NULL\&quot;\n        DATETIME created_at \&quot;DEFAULT CURRENT_TIMESTAMP\&quot;\n    }\n    login_attempts {\n        INT attempt_id PK \&quot;AUTO_INCREMENT\&quot;\n        VARCHAR(50) username \&quot;as typed; idx(username, attempted_at)\&quot;\n        VARCHAR(45) ip_address \&quot;idx(ip_address, attempted_at)\&quot;\n        DATETIME attempted_at \&quot;purged after 24 h\&quot;\n    }\n    settings {\n        TINYINT settings_id PK \&quot;always 1\&quot;\n        VARCHAR(100) business_name\n        VARCHAR(200) business_address \&quot;NULL\&quot;\n        INT table_count \&quot;&gt;= 1\&quot;\n        VARCHAR(200) receipt_footer \&quot;NULL\&quot;\n        DECIMAL operating_percent \&quot;DECIMAL(5.2), range 0-100\&quot;\n        VARCHAR(50) qris_bank \&quot;NULL\&quot;\n        VARCHAR(100) qris_owner_name \&quot;NULL\&quot;\n        VARCHAR(100) qris_image \&quot;NULL, max 2 MB\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="NWmzTbdmZL4JgmCoGEQV-1">
